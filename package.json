{
	"name": "n8n-nodes-chatagent",
	"version": "0.2.0",
	"description": "n8n community nodes for ChatAgent.so",
	"license": "MIT",
	"homepage": "https://www.chatagent.so",
	"keywords": [
		"n8n-community-node-package"
	],
	"author": {
		"name": "ChatAgent.so",
		"email": "christmantoro@gmail.com"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/ai-agents-strategy/chatagent-n8n.git"
	},
	"scripts": {
		"init": "npm install && n8n-node lint",
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"test": "vitest run",
		"test:watch": "vitest",
		"release": "n8n-node release",
		"prepublishOnly": "n8n-node prerelease"
	},
	"files": [
		"dist"
	],
	"publishConfig": {
		"access": "public"
	},
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/ChatAgentApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/ChatAgent/ChatAgent.node.js",
			"dist/nodes/ChatAgentSearchCustomer/ChatAgentSearchCustomer.node.js",
			"dist/nodes/ChatAgentConversationHistory/ChatAgentConversationHistory.node.js",
			"dist/nodes/ChatAgentSendMessage/ChatAgentSendMessage.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "^0.43.3",
		"eslint": "9.29.0",
		"prettier": "3.9.6",
		"release-it": "21.0.2",
		"typescript": "5.9.3",
		"vitest": "^4.1.10"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	}
}
